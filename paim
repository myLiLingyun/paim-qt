#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# paim (paintImproved) launcher
SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd) || exit 1
cd "$DIR" || exit 1
if [ -x "$DIR/.venv/bin/python" ]; then
  exec "$DIR/.venv/bin/python" -m mspaint "$@"
fi
if command -v python3 >/dev/null 2>&1 && python3 -c 'import PyQt6, PIL' >/dev/null 2>&1; then
  exec python3 -m mspaint "$@"
fi
printf '%s\n' "paim: PyQt6 was not found." >&2
printf '%s\n' "Run ./install.sh first, or install the dependencies manually:" >&2
printf '%s\n' "  python3 -m venv .venv" >&2
printf '%s\n' "  .venv/bin/pip install -r requirements.txt" >&2
exit 1
